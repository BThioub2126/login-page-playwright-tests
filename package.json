{
  "name": "login-page-testing-project",
  "version": "1.0.0",
  "description": "A demo login page with a Playwright end-to-end test suite, built to showcase QA/testing skills.",
  "scripts": {
    "start": "npx http-server . -p 8080 -s",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "keywords": ["testing", "playwright", "qa", "automation", "e2e"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "http-server": "^14.1.1"
  }
}